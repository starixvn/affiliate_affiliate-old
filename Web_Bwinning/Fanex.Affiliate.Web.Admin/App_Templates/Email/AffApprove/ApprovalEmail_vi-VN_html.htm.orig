<!--subject-->{systemname} Affiliates - Xác nhận thành viên chương trình liên kết {systemname}<!--/subject-->
<table width="100%">    
    <tr>
        <td valign="top" align="center" background="{rooturl}/App_Themes/Default/ImageEmail/bg.png">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="{rooturl}/App_Themes/Default/ImageEmail/top.jpg"></td>
                </tr>
                <tr height="3">
                    <td height="3"></td>
                </tr>
                <tr height="25">
                    <td bgcolor="#a30003">
                        &nbsp;&nbsp;
                        <strong style="color: #ffffff;">
                            <font style="font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif; text-transform: uppercase;">
                                Xác nhận thành viên chương trình kết nối {systemname}
                            </font>
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#ffffff"> 
                        <br />
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="15">&nbsp;</td>
                                <td>
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Kính gửi Quý khách,</strong><br /><br />

                                       Xin chúc mừng, bạn đã là hội viên chương trình liên kết {systemname}.<br /><br />

                                        Để chúng tôi có thể phục vụ bạn tốt hơn, xin vui lòng cập nhật thông tin cá nhân mới nhất và bao gồm website mới nhất (nếu có) trong "Thông tin cá nhân" tại trang chương trình liên kết {systemname}.<br /><br />

                                        Xin vui lòng gửi thư đến <a href="mailto:{mailcontact}">{mailcontact}</a> để thông báo cho chúng tôi chính xác website hoặc URLs mà bạn dự định đặt quảng cáo của {systemname}. Nếu bạn có nhu cầu thay đổi về kích cỡ của biểu ngữ, xin liên hệ với chúng tôi, chúng tôi sẽ hỗ trợ cho bạn trong thời gian sớm nhất.<br /><br />

                                        Xin lưu ý rằng, tài khoản của bạn sẽ bị đóng nếu như website hoặc URLs mà bạn đăng ký không đặt quảng cáo của {systemname} trong vòng 7 ngày sau khi được thông báo đã trở thành hội viện của chúng tôi, trừ trường hợp bạn đã gửi thư giải thích với chúng tôi trước.<br /><br />

                                        Chúng tôi chúc bạn nhiều may mắn, và mong rằng bạn sẽ tận dụng lưu lượng trang web của bạn để gặt được lợi nhuận cao nhất.<br /><br />

                                        Chân thành cảm ơn.<br /><br />

                                        Bộ phận liên kết {systemname}.<br />
                                        <a href="mailto:{mailcontact}">{mailcontact}</a>
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>     <br />  
                    </td>
                </tr>  
                <tr>
                    <td align="right" bgcolor="#d7d7d7" height="25">
                        <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            copyright © <a href="www.Aoncash.com">www.Aoncash.com</a>
                        </font>
                    </td>
                </tr>  
                <tr height="40">
                    <td align="center" bgcolor="#a30003">
                        <font style="font-size: 12px; color:#eba6a6; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Đây là lá thư tự động do hệ thống gửi, xin vui lòng không trả lời trực tiếp lá thư này.
                        </font>
                    </td>
                </tr>            
            </table>
        </td>
    </tr>    
</table>