<!--subject-->{systemname} Affiliates - [{transid}] - Permintaan pembayaran Anda telah ditolak<!--/subject-->
<table width="100%">    
    <tr>
        <td valign="top" align="center" background="{rooturl}/App_Themes/Default/ImageEmail/bg.png">
            <table width="588" cellpadding="0" cellspacing="0" border="0">
                <tr>
                    <td height="77" background="{rooturl}/App_Themes/Default/ImageEmail/top.jpg"></td>
                </tr>
                <tr height="3">
                    <td height="3"></td>
                </tr>
                <tr height="25">
                    <td bgcolor="#a30003">
                        &nbsp;&nbsp;
                        <strong style="color: #ffffff;">
                            <font style="font-size: 11px; font-family: Verdana,Arial,Helvetica,sans-serif; text-transform: uppercase;">
                                Permintaan pembayaran Anda telah ditolak
                            </font>
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td bgcolor="#ffffff"> 
                        <br />
                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                            <tr>
                                <td width="15">&nbsp;</td>
                                <td>
                                    <font style="font-size: 12px; font-family: Verdana,Arial,Helvetica,sans-serif; line-height: 22px;">
                                        <strong>Yang terhormat {fname},</strong><br /><br />

                                        Permintaan nombor referensi adalah {transid}, tanggal {winlostdate}.<br /><br /> 
 
                                        Permintaan pembayaran Anda sebesar {amount} telah dibatalkan. <br /><br />
                                         
                                        Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung. <br />
                                        Jangan ragu untuk menghubungi kami jika Anda memiliki pertanyaan atau komentar di <a href="mailto:{mailcontact}">{mailcontact}</a><br /><br />
                                         
                                         
                                        Salam Sejahtera, <br /><br />

                                        Tim di {systemname} Afiliasi<br /> 
                                        <a href="mailto:{mailcontact}">{mailcontact}</a>
                                    </font>
                                </td>
                                <td width="15">&nbsp;</td>
                            </tr>
                        </table>     <br />  
                    </td>
                </tr>  
                <tr>
                    <td align="right" bgcolor="#d7d7d7" height="25">
                        <font style="font-size: 11px; color: #333333; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            copyright © <a href="www.aoncash.com">www.aoncash.com</a>
                        </font>
                    </td>
                </tr>  
                <tr height="40">
                    <td align="center" bgcolor="#a30003">
                        <font style="font-size: 12px; color:#eba6a6; font-family: Verdana,Arial,Helvetica,sans-serif;">
                            Ini adalah sistem yang dihasilkan otomatis email, harap jangan balas email ini secara langsung.
                        </font>
                    </td>
                </tr>            
            </table>
        </td>
    </tr>    
</table>